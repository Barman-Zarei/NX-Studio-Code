{
  "name": "nx-studio",
  "displayName": "NX Studio",
  "description": "NX Studio Code core features: Pipeline Lab (CI/CD), Task Graph, Test Intelligence, Release Pilot, Git Command Center, Code Review, Secret Scanner, CI Doctor, Claude Project Agent, Compatibility Doctor.",
  "version": "1.0.0",
  "publisher": "barman",
  "license": "MIT",
  "engines": { "vscode": "^1.70.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Running pipelines, tests, tasks and git commands executes code from the workspace; they are disabled in untrusted workspaces.",
      "restrictedConfigurations": ["nx.pythonPath"]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "nx-studio", "title": "NX Studio", "icon": "media/nx.svg" }]
    },
    "views": {
      "nx-studio": [
        { "id": "nx.project", "name": "Project Intelligence" },
        { "id": "nx.pipelines", "name": "Pipelines (CI/CD)" },
        { "id": "nx.tasks", "name": "Task Graph" }
      ]
    },
    "commands": [
      { "command": "nx.menu", "title": "Command Menu", "category": "NX" },
      { "command": "nx.about", "title": "About NX Studio Code", "category": "NX" },
      { "command": "nx.analyze", "title": "Analyze Project", "category": "NX" },
      { "command": "nx.reviewFile", "title": "Review Current File", "category": "NX" },
      { "command": "nx.scanSecrets", "title": "Scan Workspace for Secrets", "category": "NX" },
      { "command": "nx.runTests", "title": "Run Tests (Test Intelligence)", "category": "NX" },
      { "command": "nx.pipeline.run", "title": "Pipeline Lab: Run Workflow Locally", "category": "NX" },
      { "command": "nx.pipeline.inspect", "title": "Pipeline Lab: Inspect Workflow", "category": "NX" },
      { "command": "nx.pipeline.lint", "title": "CI Doctor: Lint Workflows", "category": "NX" },
      { "command": "nx.tasks.run", "title": "Task Graph: Run .nx/tasks.json", "category": "NX" },
      { "command": "nx.tasks.init", "title": "Task Graph: Create .nx/tasks.json", "category": "NX" },
      { "command": "nx.release", "title": "Release Pilot", "category": "NX" },
      { "command": "nx.git", "title": "Git Command Center", "category": "NX" },
      { "command": "nx.deps", "title": "Dependency Guardian", "category": "NX" },
      { "command": "nx.forge", "title": "Project Forge: New Project", "category": "NX" },
      { "command": "nx.logs", "title": "Log Explorer: Filter / Sanitize Current File", "category": "NX" },
      { "command": "nx.profile", "title": "Profile Current Python Script", "category": "NX" },
      { "command": "nx.preview", "title": "Live Preview (127.0.0.1 only)", "category": "NX" },
      { "command": "nx.studioProfile", "title": "Apply Studio Profile", "category": "NX" },
      { "command": "nx.doctor", "title": "Compatibility Doctor", "category": "NX" },
      { "command": "nx.safeGraphics", "title": "Safe Graphics Mode (old GPUs)", "category": "NX" },
      { "command": "nx.claude.setKey", "title": "Claude: Set API Key", "category": "NX" },
      { "command": "nx.claude.ask", "title": "Claude: Ask", "category": "NX" },
      { "command": "nx.agent", "title": "Claude: Project Agent (rewrite file with approval)", "category": "NX" },
      { "command": "nx.refresh", "title": "Refresh NX Views", "category": "NX" }
    ],
    "menus": {
      "view/title": [
        { "command": "nx.refresh", "when": "view =~ /^nx\\./", "group": "navigation" }
      ],
      "editor/context": [
        { "command": "nx.reviewFile", "group": "nx@1" },
        { "command": "nx.agent", "group": "nx@2" }
      ]
    },
    "configuration": {
      "title": "NX Studio",
      "properties": {
        "nx.pythonPath": {
          "type": "string", "default": "", "scope": "machine-overridable",
          "description": "Python 3.8+ executable used by the NX core. Empty = auto-detect (python3, python, py -3)."
        },
        "nx.restrictedRun": {
          "type": "boolean", "default": true,
          "description": "Run pipelines with a scrubbed environment, timeout and resource limits (POSIX). This is NOT a sandbox."
        },
        "nx.claude.model": { "type": "string", "default": "claude-sonnet-4-6", "description": "Claude model for Ask and Project Agent." },
        "nx.claude.enabled": { "type": "boolean", "default": true, "description": "Disable to turn all Claude features off." },
        "nx.reviewOnSave": { "type": "boolean", "default": false, "description": "Run static review automatically when a Python file is saved." }
      }
    }
  }
}
